# Use when VPS runs out of memory during npm install.
# On your computer: cd client && npm ci && npm run build
# Then on VPS: docker compose -f docker-compose.yml build -f client/dockerfile.static client
FROM nginx:alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
